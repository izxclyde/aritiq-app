CREATE TABLE folder (
  id TEXT PRIMARY KEY NOT NULL,
  name TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

selectById:
SELECT * FROM folder WHERE id = :id;

selectAll:
SELECT * FROM folder ORDER BY name ASC;

insertOrReplace:
INSERT OR REPLACE INTO folder(id, name, created_at, updated_at) VALUES (:id, :name, :createdAt, :updatedAt);

deleteById:
DELETE FROM folder WHERE id = :id;