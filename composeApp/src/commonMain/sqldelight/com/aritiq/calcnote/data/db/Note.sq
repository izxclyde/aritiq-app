CREATE TABLE note (
  id TEXT PRIMARY KEY NOT NULL,
  title TEXT NOT NULL,
  content TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  is_pinned INTEGER NOT NULL DEFAULT 0,
  is_archived INTEGER NOT NULL DEFAULT 0,
  favorite INTEGER NOT NULL DEFAULT 0,
  folder_id TEXT REFERENCES folder(id) ON DELETE SET NULL
);

selectById:
SELECT * FROM note WHERE id = :id;

selectRecent:
SELECT * FROM note
WHERE is_archived = 0 AND is_pinned = 0
ORDER BY updated_at DESC
LIMIT :limit OFFSET :offset;

selectPinned:
SELECT * FROM note WHERE is_pinned = 1 AND is_archived = 0 ORDER BY updated_at DESC;

countBy:
SELECT COUNT(*) FROM note WHERE is_archived = 0;

selectArchived:
SELECT * FROM note WHERE is_archived = 1 ORDER BY updated_at DESC;

searchByText:
SELECT * FROM note
WHERE is_archived = 0 AND (title LIKE '%' || :q || '%' OR content LIKE '%' || :q || '%')
ORDER BY updated_at DESC;

-- "favorite" column is INTEGER 0/1; the generated adapter treats it as Boolean.
insertOrReplace:
INSERT OR REPLACE INTO note(id, title, content, created_at, updated_at, is_pinned, is_archived, favorite, folder_id)
VALUES (:id, :title, :content, :createdAt, :updatedAt, :isPinned, :isArchived, :favorite, :folderId);

deleteById:
DELETE FROM note WHERE id = :id;

setPinned:
UPDATE note SET is_pinned = :pinned, updated_at = :updatedAt WHERE id = :id;

setArchived:
UPDATE note SET is_archived = :archived, updated_at = :updatedAt WHERE id = :id;

setFavorite:
UPDATE note SET favorite = :favorite, updated_at = :updatedAt WHERE id = :id;

-- ponytail: no separate 'trash' table — soft delete via is_archived = 1; adds an explicit_phase2 trash key.
-- ponytail: schema only carries spec-listed fields; tags live in note_tag (Phase 2 lifted into a table).