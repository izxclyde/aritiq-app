<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Aritiq theme: classic notebook aesthetic.
      Compose Material3 takes over rendering once MainActivity's setContent block runs;
      this XML theme only paints the splash window before Compose attaches.
    -->
    <style name="Theme.CalcNote" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream_paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.CalcNote.Splash" parent="Theme.CalcNote" />

    <!-- Paper cream color for splash screen -->
    <color name="cream_paper">#FAF9F6</color>

    <!-- Dark mode sepia for splash (optional, requires API 29+ for dynamic) -->
    <color name="sepia_paper">#3E2723</color>
</resources>