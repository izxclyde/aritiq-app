<?xml version="1.0" encoding="utf-8"?>
<!--
  Aritiq launcher foreground (108dp canvas, art inside the 66dp safe zone):
  a cream notebook page with ruled lines, red margin, and a teal sigma (Σ) —
  notes + calculator in one mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Notebook page -->
    <path
        android:fillColor="#FAF9F6"
        android:pathData="M40,20 h28 a8,8 0 0 1 8,8 v52 a8,8 0 0 1 -8,8 h-28 a8,8 0 0 1 -8,-8 v-52 a8,8 0 0 1 8,-8 z" />
    <!-- Red margin line -->
    <path
        android:strokeColor="#C47070"
        android:strokeWidth="1.8"
        android:pathData="M47,28 L47,80" />
    <!-- Ruled lines -->
    <path
        android:strokeColor="#C9B8B0"
        android:strokeWidth="1.2"
        android:pathData="M53,36 L74,36 M53,44 L74,44 M53,52 L74,52 M53,60 L74,60 M53,68 L74,68 M53,76 L74,76" />
    <!-- Sigma (Σ) -->
    <path
        android:strokeColor="#00695C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M58,42 H72 L58,55 H72" />
</vector>
